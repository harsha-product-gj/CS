# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Session pooler" connection string (used by scripts: migrations, imports)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Domain used to turn usernames into Supabase login emails (never emailed)
LOGIN_EMAIL_DOMAIN=users.sleepyhug.local
